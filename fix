import os
import re
from pathlib import Path

# Final comprehensive fix for ALL remaining files
generated_dir = Path("core/src/retroproto_parsers/generated")
fixed_count = 0

# Find all files that need fixing first
problematic_files = []
for rust_file in generated_dir.rglob("*.rs"):
    try:
        with open(rust_file, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Check if the file has the exact problematic pattern
        if 'Ok(' in content and '// Some variants ignore payload in Go; we still succeed but you can switch to strict:' in content:
            problematic_files.append(rust_file)
            
    except Exception as e:
        print(f"Error checking {rust_file}: {e}")

print(f"Found {len(problematic_files)} files to fix")

# Now fix all problematic files
for rust_file in problematic_files:
    try:
        with open(rust_file, 'r', encoding='utf-8') as f:
            content = f.read()
        
        original_content = content
        
        # Get the struct name from the file
        struct_match = re.search(r'pub struct (\w+) \{\}', content)
        if struct_match:
            struct_name = struct_match.group(1)
            
            # Replace the problematic pattern
            # The pattern is: Ok(StructName {}) // comment on same line
            # Replace with: // comment on separate lines Ok(StructName {})
            content = re.sub(
                r'(\s+)Ok\(([^)]+)\)\s+// Some variants ignore payload in Go; we still succeed but you can switch to strict:',
                r'\1// Some variants ignore payload in Go; we still succeed but you can switch to strict:',
                content
            )
            
            # Also handle the case where the comment is on a separate line
            content = re.sub(
                r'(\s+)Ok\(([^)]+)\)\s*\n(\s+)// Some variants ignore payload in Go; we still succeed but you can switch to strict:',
                r'\1// Some variants ignore payload in Go; we still succeed but you can switch to strict:',
                content
            )
        
        if content != original_content:
            with open(rust_file, 'w', encoding='utf-8') as f:
                f.write(content)
            print(f"Fixed: {rust_file}")
            fixed_count += 1
            
    except Exception as e:
        print(f"Error processing {rust_file}: {e}")

print(f"Fixed {fixed_count} files")